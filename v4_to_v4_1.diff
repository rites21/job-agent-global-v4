+def select_for_analysis(pool_by_bucket, limit):
+    """Use an approximate 70/20/10 split, redistributing empty buckets."""
+    order = ("INDIA_PRIORITY", "GLOBAL_SPONSORSHIP", "GLOBAL_REMOTE")
+    quotas = {"INDIA_PRIORITY": round(limit * 0.70),
+              "GLOBAL_SPONSORSHIP": round(limit * 0.20),
+              "GLOBAL_REMOTE": max(0, limit - round(limit * 0.70) - round(limit * 0.20))}
+    selected = []
+    chosen_ids = set()
+    for bucket in order:
+        take = min(quotas[bucket], len(pool_by_bucket[bucket]))
+        selected.extend(pool_by_bucket[bucket][:take])
+        chosen_ids.update(j["id"] for j in pool_by_bucket[bucket][:take])
+    if len(selected) < limit:
+        for bucket in order:
+            for job in pool_by_bucket[bucket]:
+                if job["id"] not in chosen_ids:
+                    selected.append(job)
+                    chosen_ids.add(job["id"])
+                    if len(selected) >= limit:
+                        break
+            if len(selected) >= limit:
+                break
+    selected.sort(key=lambda j: (order.index(j["search_bucket"]), -j["rough_score"]))
+    return selected[:limit]
 
 
 
